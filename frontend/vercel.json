{
 "cleanUrls": true,
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/price-index",
   "destination": "/price-report",
   "permanent": true
  },
  {
   "source": "/how-it-works",
   "destination": "/#how",
   "permanent": true
  }
 ],
 "headers": [
  {
   "source": "/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ]
}